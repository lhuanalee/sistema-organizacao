// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  categories Category[]
  tasks      Task[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String
  icon      String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@unique([userId, name])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// ACTIVITY: a to-do — shows a "done" checkbox, struck through once complete.
// COMMITMENT: a fixed appointment (class, event, party) — nothing to "finish".
enum TaskType {
  ACTIVITY
  COMMITMENT
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        TaskType  @default(ACTIVITY)
  priority    Priority  @default(MEDIUM)
  done        Boolean   @default(false)
  completedAt DateTime?

  // When null, the task lives in the backlog list.
  // When set, the task is scheduled onto the calendar.
  start  DateTime?
  end    DateTime?
  allDay Boolean   @default(false)

  // Days of week (0=Sun..6=Sat) this task repeats on. Empty means one-off.
  // `start`'s date is the anchor the recurrence begins from; its time of
  // day (and `end`'s) is reused as the weekly start/end time.
  recurringDaysOfWeek Int[] @default([])
  // Series stops occurring on/after this date ("delete this and following").
  recurringUntil DateTime?
  // Individual occurrence dates skipped ("delete only this occurrence").
  recurringExcludedDates DateTime[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, start])
}
